# Database - use either Postgres or MySQL connection string
# Postgres:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hcp_crm
# MySQL (alternative):
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/hcp_crm

# Groq API (create a new key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=gemma2-9b-it
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# CORS
FRONTEND_ORIGIN=http://localhost:3000
